# ~/.zshrc

# 1. PATH per binari locali e script utente
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# 2. Carica l'ambiente Homebrew
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# 3. Completamento nativo Zsh
autoload -U compinit
compinit

# Permette il completamento con TAB anche a metà parola
setopt COMPLETE_IN_WORD

# 4. Inizializzazione Strumenti
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"

# 5. Plugin Zsh (Autosuggestions & Syntax Highlighting)
# Supporta sia i percorsi di sistema (/usr/share) sia Homebrew
if [ -f "/usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
    source "/usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
elif [ -n "$HOMEBREW_PREFIX" ] && [ -f "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
    source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# NOTA: syntax-highlighting deve essere sempre caricato per ultimo
if [ -f "/usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
    source "/usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
elif [ -n "$HOMEBREW_PREFIX" ] && [ -f "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
    source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# 6. Mise (Polyglot dev tool & runtime version manager)
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate zsh)"
fi

if [ -n "$CONTAINER_ID" ]; then
    # ROBA ESCLUSIVA DISTROBOX
    alias nautilus="distrobox-host-exec nautilus"
fi


alias ls="eza --icons --git"
alias cd="z"
alias whereami="pwd"
alias cl="clear"
alias zed="zeditor"

# Added by Antigravity CLI installer
export PATH="/var/home/v/.local/bin:$PATH"

### KEYBINDS
# Movimento tra parole: Alt + Freccia Destra / Sinistra
bindkey "^[[1;3C" forward-word
bindkey "^[[1;3D" backward-word

# Movimento tra parole: Ctrl + Freccia Destra / Sinistra
bindkey "^[[1;5C" forward-word
bindkey "^[[1;5D" backward-word

# Varianti per terminali con sequenze legacy (xterm/rxvt)
bindkey "^[^[[C" forward-word
bindkey "^[^[[D" backward-word
